<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RoyalPlay.Pages.HomePage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush EndPoint="1,1">
            <GradientStop Color="#071218" Offset="0"/>
            <GradientStop Color="#19333B" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="24,26" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="♠  ROYALPLAY"
                        TextColor="#D8B574"
                        FontSize="28"
                        FontAttributes="Bold"/>
                    <Label
                        x:Name="WelcomeLabel"
                        Text="WELCOME BACK"
                        TextColor="#B8CDCA"
                        FontSize="12"/>
                </VerticalStackLayout>

                <Label
                    Grid.Column="1"
                    Text="♣ ♦ ♥"
                    TextColor="#47645F"
                    FontSize="18"
                    VerticalOptions="Center"/>
            </Grid>

            <Border
                BackgroundColor="#1B303A"
                Stroke="#52614F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="YOUR CHIP BALANCE"
                            TextColor="#A8BDBB"
                            FontSize="11"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="BalanceLabel"
                            Text="0"
                            TextColor="#F4D89B"
                            FontSize="35"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="XpLabel"
                            Text="0 XP"
                            TextColor="#D4E0DC"
                            FontSize="13"/>

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="◉"
                        FontSize="65"
                        TextColor="#D8B574"
                        VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Label
                Text="CHOOSE YOUR GAME"
                TextColor="#F7F0E2"
                FontAttributes="Bold"
                FontSize="19"
                Margin="0,6,0,0"/>

            <Border
                BackgroundColor="#145943"
                Stroke="#C6A96F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="TEXAS HOLD'EM"
                                FontSize="23"
                                TextColor="White"
                                FontAttributes="Bold"/>
                            <Label
                                Text="1–3 computer opponents"
                                FontSize="13"
                                TextColor="#C2E0D2"/>
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="♠"
                            TextColor="#E7C584"
                            FontSize="45"/>
                    </Grid>

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Border
                            BackgroundColor="#FFF8EE"
                            Stroke="#E6D6B9"
                            StrokeShape="RoundRectangle 9"
                            WidthRequest="65"
                            HeightRequest="87">

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                                <Label
                                    Text="A"
                                    TextColor="#172834"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"/>

                                <Label
                                    Text="♠"
                                    TextColor="#172834"
                                    FontSize="26"
                                    HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            BackgroundColor="#FFF8EE"
                            Stroke="#E6D6B9"
                            StrokeShape="RoundRectangle 9"
                            WidthRequest="65"
                            HeightRequest="87">

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                                <Label
                                    Text="K"
                                    TextColor="#BE3644"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"/>

                                <Label
                                    Text="♥"
                                    TextColor="#BE3644"
                                    FontSize="26"
                                    HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <Button
                        Text="PLAY POKER"
                        Clicked="PokerButton_Clicked"
                        BackgroundColor="#D8B574"
                        TextColor="#11232A"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="49"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Border
                    Stroke="#6A7066"
                    BackgroundColor="#223E3C"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="♣" TextColor="#D8B574" FontSize="39"/>
                        <Label Text="BLACKJACK" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="Beat the dealer" TextColor="#BBD0C8" FontSize="11"/>

                        <Button
                            Text="PLAY"
                            Clicked="BlackjackButton_Clicked"
                            BackgroundColor="#D8B574"
                            TextColor="#11232A"
                            FontAttributes="Bold"
                            CornerRadius="11"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    Stroke="#61728A"
                    BackgroundColor="#263F5A"
                    StrokeShape="RoundRectangle 17"
                    Padding="15">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="★" TextColor="#D8B574" FontSize="39"/>
                        <Label Text="SPORTS" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="Predict real games" TextColor="#C4D5E4" FontSize="11"/>

                        <Button
                            Text="EXPLORE"
                            Clicked="SportsButton_Clicked"
                            BackgroundColor="#D8B574"
                            TextColor="#11232A"
                            FontAttributes="Bold"
                            CornerRadius="11"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
