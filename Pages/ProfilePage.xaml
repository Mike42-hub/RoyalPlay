<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RoyalPlay.Pages.ProfilePage"
    BackgroundColor="#09161C"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="18">

            <Label
                Text="PLAYER PROFILE"
                TextColor="#D8B574"
                FontSize="26"
                FontAttributes="Bold"/>

            <Border
                BackgroundColor="#20333C"
                Stroke="#8C7951"
                StrokeShape="RoundRectangle 22"
                Padding="25">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Label
                        Text="♠"
                        FontSize="65"
                        TextColor="#D8B574"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        x:Name="PlayerNameLabel"
                        Text="PLAYER"
                        TextColor="White"
                        FontSize="25"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        x:Name="ChipsLabel"
                        Text="0 CHIPS"
                        TextColor="#D8B574"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        x:Name="XpLabel"
                        Text="0 XP"
                        TextColor="#AAB8BD"
                        FontSize="13"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Border
                    BackgroundColor="#1C303A"
                    Stroke="#324956"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="GAMES PLAYED"
                            TextColor="#AAB8BD"
                            FontSize="11"/>

                        <Label
                            x:Name="GamesPlayedLabel"
                            Text="0"
                            TextColor="White"
                            FontSize="29"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="#1C303A"
                    Stroke="#324956"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="PREDICTION XP"
                            TextColor="#AAB8BD"
                            FontSize="11"/>

                        <Label
                            x:Name="PredictionPointsLabel"
                            Text="0"
                            TextColor="White"
                            FontSize="29"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Button
                Text="SETTINGS"
                Clicked="SettingsButton_Clicked"
                BackgroundColor="#233B47"
                TextColor="#EAEDE8"
                HeightRequest="50"
                CornerRadius="12"/>

            <Button
                Text="LOG OUT"
                Clicked="LogoutButton_Clicked"
                BackgroundColor="#D8B574"
                TextColor="#0D1720"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="12"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
